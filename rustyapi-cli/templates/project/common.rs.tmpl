//! Общие помощники тестов.

#![allow(dead_code)]

use http_body_util::BodyExt;
use rustyapi::axum::body::Body;
use rustyapi::axum::http::Request;
use rustyapi::db::Pool;
use rustyapi::prelude::*;
use tower::ServiceExt;

/// Пул на отдельной схеме тестовой базы с применёнными миграциями.
/// `None`, если `DATABASE_URL` не задан (тест тогда пропускается).
pub async fn test_pool(schema: &str) -> Option<Pool> {
    let _ = rustyapi::dotenvy::dotenv();
    let Ok(url) = std::env::var("DATABASE_URL") else {
        eprintln!("DATABASE_URL не задан, тест пропущен");
        return None;
    };
    let admin = rustyapi::db::pool_from_url(&url).unwrap();
    rustyapi::sqlx::raw_sql(&format!(
        "DROP SCHEMA IF EXISTS {schema} CASCADE; CREATE SCHEMA {schema};"
    ))
    .execute(&admin)
    .await
    .unwrap();
    let sep = if url.contains('?') { '&' } else { '?' };
    let pool =
        rustyapi::db::pool_from_url(&format!("{url}{sep}options=-c%20search_path%3D{schema}"))
            .unwrap();
    {{crate_ident}}::app()
        .database(pool.clone())
        .run_migrations()
        .await
        .unwrap();
    Some(pool)
}

/// Запрос к приложению: `(статус, JSON-ответ)`.
pub async fn call(pool: Option<&Pool>, method: &str, uri: &str, body: Option<Value>) -> (u16, Value) {
    let mut request = Request::builder().method(method).uri(uri);
    let body = match body {
        Some(json) => {
            request = request.header("content-type", "application/json");
            Body::from(json.to_string())
        }
        None => Body::empty(),
    };
    // Без базы — ленивый пул на несуществующий сервер: ошибки 422 возникают раньше запросов к БД.
    let pool = match pool {
        Some(pool) => pool.clone(),
        None => rustyapi::db::pool_from_url("postgres://nobody@127.0.0.1:1/none").unwrap(),
    };
    let response = {{crate_ident}}::app()
        .database(pool)
        .into_router()
        .oneshot(request.body(body).unwrap())
        .await
        .unwrap();
    let status = response.status().as_u16();
    let bytes = response.into_body().collect().await.unwrap().to_bytes();
    let json = if bytes.is_empty() {
        Value::Null
    } else {
        rustyapi::serde_json::from_slice(&bytes).unwrap()
    };
    (status, json)
}
