//! Общие помощники тестов.

#![allow(dead_code)]

use rustyapi::db::Pool;
use rustyapi::testing::TestClient;

/// Пул на отдельной схеме тестовой базы с применёнными миграциями.
/// `None`, если `DATABASE_URL` не задан (тест тогда пропускается).
pub async fn test_pool(schema: &str) -> Option<Pool> {
    let _ = rustyapi::dotenvy::dotenv();
    let Ok(url) = std::env::var("DATABASE_URL") else {
        eprintln!("DATABASE_URL не задан, тест пропущен");
        return None;
    };
    let admin = rustyapi::db::pool_from_url(&url).unwrap();
    rustyapi::sqlx::raw_sql(&format!(
        "DROP SCHEMA IF EXISTS {schema} CASCADE; CREATE SCHEMA {schema};"
    ))
    .execute(&admin)
    .await
    .unwrap();
    let sep = if url.contains('?') { '&' } else { '?' };
    let pool =
        rustyapi::db::pool_from_url(&format!("{url}{sep}options=-c%20search_path%3D{schema}"))
            .unwrap();
    {{crate_ident}}::app()
        .database(pool.clone())
        .run_migrations()
        .await
        .unwrap();
    Some(pool)
}

/// Клиент приложения. Без базы — ленивый пул на несуществующий сервер: ошибки 422 возникают
/// раньше запросов к БД.
pub fn client(pool: Option<&Pool>) -> TestClient {
    let pool = match pool {
        Some(pool) => pool.clone(),
        None => rustyapi::db::pool_from_url("postgres://nobody@127.0.0.1:1/none").unwrap(),
    };
    TestClient::new({{crate_ident}}::app().database(pool))
}
