mod common;

use rustyapi::prelude::*;

#[rustyapi::tokio::test(crate = "rustyapi::tokio")]
async fn {{plural}}_crud() {
    let Some(pool) = common::test_pool("test_{{plural}}").await else {
        return;
    };
    let client = common::client(Some(&pool));
    let created = client.post("/{{plural}}").json(&json!({"name": "first"})).await;
    assert_eq!(created.status(), 201);
    let id = created.json::<Value>()["id"].as_i64().unwrap();

    let list = client.get("/{{plural}}").await.json::<Vec<Value>>();
    assert_eq!(list.len(), 1);

    let updated = client
        .patch(format!("/{{plural}}/{id}"))
        .json(&json!({"name": "renamed"}))
        .await;
    assert_eq!(updated.json::<Value>()["name"], "renamed");

    assert_eq!(client.delete(format!("/{{plural}}/{id}")).await.status(), 204);
    let missing = client.get(format!("/{{plural}}/{id}")).await;
    assert_eq!(
        (missing.status_code(), missing.json::<Value>()),
        (404, json!({"detail": "{{Name}} not found"}))
    );
}

#[rustyapi::tokio::test(crate = "rustyapi::tokio")]
async fn {{plural}}_validation() {
    let response = common::client(None)
        .post("/{{plural}}")
        .json(&json!({"name": ""}))
        .await;
    assert_eq!(response.status(), 422);
    assert_eq!(
        response.json::<Value>()["detail"][0]["loc"],
        json!(["body", "name"])
    );
}
