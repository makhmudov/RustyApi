# Скопируйте в .env: cp .env.example .env
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shortener
REDIS_URL=redis://127.0.0.1:6379/
# Обязательно в продакшене: openssl rand -hex 32
SECRET_KEY=change-me-change-me-change-me-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECS=10
BODY_LIMIT_BYTES=65536
# За nginx / балансировщиком: брать IP клиента из X-Forwarded-For
TRUST_PROXY=false
RUST_LOG=info
